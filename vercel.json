{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/images/adv.pdf",
      "destination": "https://adviserinfo.sec.gov/firm/summary/310581",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us.html",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/about-us/9-team/20-bio.html",
      "destination": "/team/alex-r-potenza.html",
      "permanent": true
    },
    {
      "source": "/about-us/9-team/22-cindi-mackay.html",
      "destination": "/team/cindi-mackay.html",
      "permanent": true
    },
    {
      "source": "/about-us/9-team/23-alexander-j-potenza.html",
      "destination": "/team/alex-j-potenza.html",
      "permanent": true
    },
    {
      "source": "/9-team/20-bio.html",
      "destination": "/team/alex-r-potenza.html",
      "permanent": true
    },
    {
      "source": "/9-team/22-cindi-mackay.html",
      "destination": "/team/cindi-mackay.html",
      "permanent": true
    },
    {
      "source": "/9-team/23-alexander-j-potenza.html",
      "destination": "/team/alex-j-potenza.html",
      "permanent": true
    },
    {
      "source": "/about-us/:path*",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/resources.html",
      "destination": "/services.html",
      "permanent": true
    },
    {
      "source": "/resources/blog.html",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/resources/blog/25-unlocking-the-backdoor-roth-ira-a-strategic-approach-to-tax-efficient-savings.html",
      "destination": "/blog/backdoor-roth-ira-strategy.html",
      "permanent": true
    },
    {
      "source": "/resources/blog/26-converting-your-529-college-savings-plan-to-a-roth-ira-it-s-benefits.html",
      "destination": "/blog/529-to-roth-ira-rollover.html",
      "permanent": true
    },
    {
      "source": "/resources/:path*",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/component/tags/tag/financial-planning.html",
      "destination": "/services.html#financial-planning",
      "permanent": true
    },
    {
      "source": "/component/tags/tag/investing.html",
      "destination": "/services.html#investment-management",
      "permanent": true
    },
    {
      "source": "/529-to-roth-ira-rollover.html",
      "destination": "/blog/529-to-roth-ira-rollover.html",
      "permanent": true
    },
    {
      "source": "/backdoor-roth-ira-strategy.html",
      "destination": "/blog/backdoor-roth-ira-strategy.html",
      "permanent": true
    },
    {
      "source": "/hsa-shoebox-strategy.html",
      "destination": "/blog/hsa-shoebox-strategy.html",
      "permanent": true
    },
    {
      "source": "/alex-r-potenza.html",
      "destination": "/team/alex-r-potenza.html",
      "permanent": true
    },
    {
      "source": "/alex-j-potenza.html",
      "destination": "/team/alex-j-potenza.html",
      "permanent": true
    },
    {
      "source": "/cindi-mackay.html",
      "destination": "/team/cindi-mackay.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
